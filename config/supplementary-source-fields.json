{
  "schemaVersion": 1,
  "sources": [
    {
      "resourceId": "clinvar",
      "contractId": "clinvar-fastvep-fields-v1",
      "categoricalFields": [
        {
          "field": "significance",
          "matchMode": "set",
          "parser": "json",
          "discoverObserved": true,
          "values": [
            { "value": "Benign", "label": "Benign" },
            { "value": "Likely_benign", "label": "Likely benign" },
            { "value": "Benign/Likely_benign", "label": "Benign / likely benign" },
            { "value": "Uncertain_significance", "label": "Uncertain significance" },
            { "value": "Likely_pathogenic", "label": "Likely pathogenic" },
            { "value": "Pathogenic", "label": "Pathogenic" },
            { "value": "Pathogenic/Likely_pathogenic", "label": "Pathogenic / likely pathogenic" },
            { "value": "Conflicting_classifications_of_pathogenicity", "label": "Conflicting classifications" },
            { "value": "risk_factor", "label": "Risk factor" },
            { "value": "association", "label": "Association" },
            { "value": "drug_response", "label": "Drug response" },
            { "value": "protective", "label": "Protective" },
            { "value": "affects", "label": "Affects" },
            { "value": "other", "label": "Other" },
            { "value": "not_provided", "label": "Not provided" }
          ]
        },
        {
          "field": "reviewStatus",
          "matchMode": "scalar",
          "parser": "scalar",
          "discoverObserved": true,
          "values": [
            { "value": "practice_guideline", "label": "Practice guideline" },
            { "value": "reviewed_by_expert_panel", "label": "Reviewed by expert panel" },
            { "value": "criteria_provided,_multiple_submitters,_no_conflicts", "label": "Multiple submitters, no conflicts" },
            { "value": "criteria_provided,_conflicting_classifications", "label": "Conflicting classifications" },
            { "value": "criteria_provided,_single_submitter", "label": "Single submitter" },
            { "value": "no_assertion_criteria_provided", "label": "No assertion criteria provided" },
            { "value": "no_classification_provided", "label": "No classification provided" },
            { "value": "no_classification_for_the_single_variant", "label": "No classification for the individual variant" },
            { "value": "no_classifications_from_unflagged_records", "label": "No classifications from unflagged records" }
          ]
        },
        {
          "field": "variantClass",
          "matchMode": "scalar",
          "parser": "scalar",
          "discoverObserved": true,
          "values": [
            { "value": "single_nucleotide_variant", "label": "Single nucleotide variant" },
            { "value": "Deletion", "label": "Deletion" },
            { "value": "Duplication", "label": "Duplication" },
            { "value": "Insertion", "label": "Insertion" },
            { "value": "Indel", "label": "Indel" },
            { "value": "Microsatellite", "label": "Microsatellite" },
            { "value": "Inversion", "label": "Inversion" }
          ]
        }
      ],
      "groups": [
        {
          "id": "current",
          "label": "Current AnnoCAT fields",
          "default": true,
          "fields": [
            "significance", "reviewStatus", "phenotypes", "variantClass", "soAccession",
            "afExac", "afTgp", "afEsp"
          ]
        },
        {
          "id": "additional",
          "label": "Additional ClinVar fields",
          "default": false,
          "fields": [
            "geneInfo", "diseaseDatabases", "molecularConsequences", "origin",
            "conflictingSignificance"
          ]
        }
      ]
    },
    {
      "resourceId": "dbsnp",
      "contractId": "dbsnp-fastvep-fields-v1",
      "categoricalFields": [
        {
          "field": "variantType",
          "matchMode": "scalar",
          "parser": "scalar",
          "discoverObserved": true,
          "values": [
            { "value": "SNV", "label": "Single nucleotide variant (SNV)" },
            { "value": "DIV", "label": "Deletion/insertion variant (DIV)" },
            { "value": "MNV", "label": "Multiple nucleotide variant (MNV)" }
          ]
        }
      ],
      "groups": [
        { "id": "current", "label": "Current AnnoCAT fields", "default": true, "fields": ["id", "globalMaf"] },
        { "id": "additional", "label": "Additional dbSNP fields", "default": false, "fields": ["variantType", "common"] }
      ]
    },
    {
      "resourceId": "gnomad",
      "contractId": "gnomad-fastvep-fields-v1",
      "groups": [
        {
          "id": "current",
          "label": "Current frequency fields",
          "default": true,
          "fields": [
            "allAf", "allAn", "allAc", "allHc", "afrAf", "amrAf", "asjAf", "easAf",
            "finAf", "midAf", "nfeAf", "othAf", "remainingAf", "sasAf"
          ]
        },
        {
          "id": "additional",
          "label": "Additional filtering fields",
          "default": false,
          "fields": ["filters", "faf95", "faf99", "grpmaxAf", "grpmaxPopulation"]
        }
      ]
    },
    {
      "resourceId": "gnomad-genomes",
      "contractId": "gnomad-genomes-fastvep-fields-v1",
      "groups": [
        {
          "id": "current",
          "label": "Current frequency fields",
          "default": true,
          "fields": [
            "allAf", "allAn", "allAc", "allHc", "afrAf", "amrAf", "asjAf", "easAf",
            "finAf", "midAf", "nfeAf", "othAf", "remainingAf", "sasAf"
          ]
        },
        {
          "id": "additional",
          "label": "Additional filtering fields",
          "default": false,
          "fields": ["filters", "faf95", "faf99", "grpmaxAf", "grpmaxPopulation"]
        }
      ]
    },
    {
      "resourceId": "phylop",
      "contractId": "phylop-fastvep-fields-v1",
      "groups": [
        { "id": "score", "label": "Conservation score", "default": true, "required": true, "fields": ["score"] }
      ]
    },
    {
      "resourceId": "cadd",
      "contractId": "cadd-fastvep-fields-v1",
      "groups": [
        { "id": "scores", "label": "CADD scores", "default": true, "fields": ["raw", "phred"] }
      ]
    },
    {
      "resourceId": "spliceai",
      "contractId": "spliceai-fastvep-fields-v2",
      "groups": [
        {
          "id": "identity",
          "label": "Gene matching",
          "default": true,
          "required": true,
          "fields": ["gene"]
        },
        {
          "id": "predictions",
          "label": "SpliceAI predictions",
          "default": true,
          "fields": ["dsAg", "dsAl", "dsDg", "dsDl", "dpAg", "dpAl", "dpDg", "dpDl"]
        }
      ]
    },
    {
      "resourceId": "revel",
      "contractId": "revel-fastvep-fields-v2",
      "groups": [
        { "id": "identity", "label": "Transcript matching", "default": true, "required": true, "fields": ["transcriptId", "aaRef", "aaAlt"] },
        { "id": "score", "label": "REVEL score", "default": true, "fields": ["score"] }
      ]
    }
  ]
}
