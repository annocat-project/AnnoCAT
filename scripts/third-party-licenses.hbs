<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Third-party licenses</title>
  <style>
    body { font: 16px/1.5 sans-serif; max-width: 72rem; margin: 2rem auto; padding: 0 1rem; color: #242424; }
    h2 { margin-top: 2.5rem; }
    pre { white-space: pre-wrap; overflow-wrap: anywhere; padding: 1rem; background: #f5f5f5; }
  </style>
</head>
<body>
  <h1>Third-party licenses</h1>
  <p>This file lists licenses for Rust packages linked into the Windows release.</p>
  {{#each licenses}}
  {{#if first_of_kind}}<h2 id="{{id}}">{{name}}</h2>{{/if}}
  <h3>{{name}}</h3>
  <p>Used by:</p>
  <ul>
    {{#each used_by}}
    <li>{{crate.name}} {{crate.version}}</li>
    {{/each}}
  </ul>
  <pre>{{text}}</pre>
  {{/each}}
</body>
</html>
